PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=virtual_lab
# Dev uchun true (jadvallarni avtomatik yaratadi). Productionda false qilib migratsiya ishlating.
DB_SYNC=true

# Login uchun maxfiy kalit (uzun tasodifiy matn qo'ying)
JWT_SECRET=bu-yerga-uzun-tasodifiy-matn-yozing

# AI yordamchi. Eng oson va tekin yo'l: Groq (https://console.groq.com/keys -> Create API Key)
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Ixtiyoriy: boshqa provayderlar (AI_PROVIDER=gemini yoki anthropic qilib almashtiring)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
